# Telegram Bot Token (required)
BOT_TOKEN=

# Environment: development | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Telethon API credentials (required for Telethon session generation)
TELETHON_API_ID=
TELETHON_API_HASH=

# Pyrogram API credentials (required for Pyrogram v2 session generation)
PYROGRAM_API_ID=
PYROGRAM_API_HASH=
